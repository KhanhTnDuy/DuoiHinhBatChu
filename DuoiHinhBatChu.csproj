<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!--
    Dự án WPF nằm ngay thư mục gốc nên mặc định nó gom cả file của các dự án con.
    Phải loại ra, không thì mỗi lớp bị biên dịch hai lần.
    Thêm dự án con mới thì nhớ thêm một dòng vào đây.
  -->
  <ItemGroup>
    <Compile Remove="DuoiHinhBatChu.Core\**;DuoiHinhBatChu.Server\**" />
    <Page Remove="DuoiHinhBatChu.Core\**;DuoiHinhBatChu.Server\**" />
    <Content Remove="DuoiHinhBatChu.Core\**;DuoiHinhBatChu.Server\**" />
    <None Remove="DuoiHinhBatChu.Core\**;DuoiHinhBatChu.Server\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phần lõi không phụ thuộc WPF, dùng chung với máy chủ sau này -->
    <ProjectReference Include="DuoiHinhBatChu.Core\DuoiHinhBatChu.Core.csproj" />
    <!--
      Máy chủ đấu: KHÔNG tham chiếu mã, chỉ để build app là build luôn máy chủ,
      nhờ đó Services/LocalServer luôn tìm thấy DuoiHinhBatChu.Server.exe để
      tự bật khi người chơi vào chế độ đấu.
    -->
    <ProjectReference Include="DuoiHinhBatChu.Server\DuoiHinhBatChu.Server.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ảnh câu đố: mỗi file là một câu, tên file chính là đáp án (vd "CÁ HEO.png") -->
    <!--
      ExcludeCauHoi=true (dotnet publish -p:ExcludeCauHoi=true) bỏ bộ ảnh ra khỏi gói:
      bộ ảnh nặng ~360 MB, và đóng gói một file thì chúng bị nhét hẳn vào trong .exe.
      Bản gửi bạn bè chỉ để VÀO PHÒNG nên không cần ảnh (máy chủ của chủ phòng gửi ảnh
      cho họ). Bản dev bình thường không đặt cờ này nên vẫn kèm đủ ảnh.
    -->
    <Content Include="Assets\CauHoi\**\*.*" Condition="'$(ExcludeCauHoi)' != 'true'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Ảnh tài nguyên của app: mã QR ủng hộ, logo... (xem AppImageLocator) -->
    <Content Include="Assets\TaiNguyen\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Ảnh nền bầu trời của màn menu (sáng / tối).
      Build Action = Resource chứ không phải Content: hai ảnh này được XAML gọi
      thẳng bằng đường dẫn "/Assets/NenTroi/..." trong Themes/Light.xaml và
      Dark.xaml, nên chúng phải nằm TRONG file .exe, không phải nằm cạnh nó.
      Đổi ảnh thì phải build lại — đúng như vậy, vì ảnh nền là một phần của bộ
      màu giao diện, không phải tài nguyên thả tay như Assets/TaiNguyen.
    -->
    <Resource Include="Assets\NenTroi\**\*.png" />

    <!-- Gợi ý và độ khó bổ sung cho từng đáp án (tùy chọn) -->
    <Content Include="Data\puzzles.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
  </ItemGroup>

</Project>
