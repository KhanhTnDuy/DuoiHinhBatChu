<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DuoiHinhBatChu.Core\DuoiHinhBatChu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Dùng chung kho ảnh với client. Máy chủ cần ảnh vì nó vừa bốc câu vừa
      phục vụ GET /api/puzzles/{ten}/image, nhờ đó máy người chơi không phải
      có sẵn đúng bộ ảnh mới đấu được.
    -->
    <Content Include="..\Assets\CauHoi\**\*.*" LinkBase="Assets\CauHoi">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Chủ đề + độ khó chấm tay của từng câu. Thiếu file này thì PuzzleSync ở
      máy chủ rơi về mặc định (chủ đề "Cụm từ", độ khó đoán theo độ dài) và
      màn đấu hiện độ khó / câu dẫn khác hẳn màn Cổ điển của cùng một câu.
    -->
    <Content Include="..\Data\puzzles.json" Link="Data\puzzles.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
