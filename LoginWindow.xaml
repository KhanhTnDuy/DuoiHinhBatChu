<Window x:Class="DuoiHinhBatChu.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:DuoiHinhBatChu.Converters"
        Title="Đuổi hình bắt chữ - Đăng nhập"
        Width="960" Height="740"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource SkyBrush}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:StringToVisibilityConverter x:Key="StrVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== Bên trái: giới thiệu chế độ chơi ==================== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Center" Margin="48,0">

                <!-- ===== Logo: một bức tranh, mũi tên, rồi hàng ô chữ =====
                     Vẽ hẳn bằng hình khối chứ không dùng file ảnh, để nét luôn
                     sắc ở mọi cỡ màn hình và tự đổi màu theo nền sáng/tối. -->
                <Border Width="200" Height="132" CornerRadius="14" Padding="0"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Grid ClipToBounds="True">
                        <!-- Mặt trời -->
                        <Ellipse Width="38" Height="38" Margin="0,18,26,0"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Fill="{DynamicResource TertiaryBrush}"/>
                        <!-- Hai dãy núi, dãy sau nhạt hơn cho có chiều sâu -->
                        <Path Data="M -10,132 L 70,52 L 150,132 Z" Opacity="0.45"
                              Fill="{DynamicResource PrimaryBrush}"/>
                        <Path Data="M 60,132 L 130,70 L 210,132 Z"
                              Fill="{DynamicResource PrimaryBrush}"/>
                    </Grid>
                </Border>

                <!-- Mũi tên: từ hình ra chữ -->
                <Path Data="M 8,0 L 8,20 M 0,12 L 8,21 L 16,12"
                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Margin="92,12,0,12" HorizontalAlignment="Left"/>

                <!-- Ba ô chữ, ô cuối còn trống như đang chờ người chơi ghép nốt -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,22">
                    <Border Width="44" Height="52" CornerRadius="10" Margin="0,0,8,0"
                            Background="{DynamicResource SlotFilledBrush}">
                        <TextBlock Text="C" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SlotFilledTextBrush}"/>
                    </Border>
                    <Border Width="44" Height="52" CornerRadius="10" Margin="0,0,8,0"
                            Background="{DynamicResource SlotFilledBrush}">
                        <TextBlock Text="H" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SlotFilledTextBrush}"/>
                    </Border>
                    <Rectangle Width="44" Height="52" RadiusX="10" RadiusY="10"
                               Stroke="{DynamicResource SlotEmptyBrush}"
                               StrokeThickness="2" StrokeDashArray="4 3"/>
                </StackPanel>

                <TextBlock Text="ĐUỔI HÌNH" FontSize="34" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryBrush}"/>
                <TextBlock Text="BẮT CHỮ" FontSize="34" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- Chỉ giữ một câu; phần luật chơi dài nằm trong nút "?" góc trên -->
                <TextBlock TextWrapping="Wrap" FontSize="15" LineHeight="24"
                           Margin="0,20,0,0" MaxWidth="360" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Nhìn hình đoán chữ."/>
            </StackPanel>
        </Border>

        <!-- ==================== Bên phải: đăng nhập / đăng ký ==================== -->
        <Grid Grid.Column="1" Margin="36,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Tên màn hình + hai thẻ chuyển qua lại -->
            <StackPanel Grid.Row="0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ShowLoginCommand}" Content="Đăng nhập"
                            Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoginMode}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource PrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ShowRegisterCommand}" Content="Đăng ký">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource PrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource HelpButton}" Margin="0,0,8,0"
                            Command="{Binding ShowHelpCommand}"/>
                    <Button Style="{StaticResource ThemeToggleButton}"
                            Command="{Binding ToggleThemeCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Tên thẻ đang mở nằm dưới hàng nút, ngay trên các ô nhập của nó -->
            <TextBlock FontSize="30" FontWeight="Bold" Margin="0,18,0,0"
                       Foreground="{DynamicResource PrimaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="ĐĂNG NHẬP"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                <Setter Property="Text" Value="ĐĂNG KÝ"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsForgotMode}" Value="True">
                                <Setter Property="Text" Value="QUÊN MẬT KHẨU"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </StackPanel>

            <!-- Ô nhập. Bọc ScrollViewer vì thẻ Đăng ký cao hơn thẻ Đăng nhập -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,18">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Tên đăng nhập"/>
                <TextBox x:Name="UserNameBox" Style="{StaticResource Field}"
                         Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Chỉ khi đăng ký -->
                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolVis}}">
                    <!-- Nhãn để trơn cho gọn; chuyện "để trống được" nằm trong tooltip của ô nhập -->
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Tên hiển thị"/>
                    <TextBox Style="{StaticResource Field}"
                             ToolTip="Để trống thì lấy luôn tên đăng nhập"
                             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Số điện thoại: đăng ký thì khai, quên mật khẩu thì khai lại đúng số đó -->
                <StackPanel Margin="0,14,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsForgotMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Số điện thoại"/>
                    <TextBox Style="{StaticResource Field}" MaxLength="15"
                             ToolTip="10 chữ số, bắt đầu bằng 0 - dùng để lấy lại tài khoản khi quên mật khẩu"
                             Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <TextBlock Margin="0,14,0,6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                            <Setter Property="Text" Value="Mật khẩu"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsForgotMode}" Value="True">
                                    <Setter Property="Text" Value="Mật khẩu mới"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordField}"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <!-- Nhập lại mật khẩu: cần cả khi đăng ký lẫn khi đặt lại mật khẩu -->
                <StackPanel Margin="0,14,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsForgotMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Nhập lại mật khẩu"/>
                    <PasswordBox x:Name="ConfirmBox" Style="{StaticResource PasswordField}"
                                 PasswordChanged="ConfirmBox_PasswordChanged"/>
                </StackPanel>

                <!-- Báo lỗi -->
                <Border CornerRadius="10" Padding="12,9" Margin="0,14,0,0"
                        Background="{DynamicResource ErrorSoftBrush}"
                        Visibility="{Binding Error, Converter={StaticResource StrVis}}">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource ErrorBrush}"/>
                </Border>

                <Button Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"
                        Command="{Binding LoginCommand}" Content="Đăng nhập"
                        Visibility="{Binding IsLoginMode, Converter={StaticResource BoolVis}}"/>

                <Button Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"
                        Command="{Binding RegisterCommand}" Content="Tạo tài khoản"
                        Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolVis}}"/>

                <Button Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"
                        Command="{Binding ResetPasswordCommand}" Content="Đặt mật khẩu mới"
                        Visibility="{Binding IsForgotMode, Converter={StaticResource BoolVis}}"/>

                <!-- Lối sang thẻ quên mật khẩu, chỉ hiện khi đang ở thẻ đăng nhập -->
                <Button Style="{StaticResource LinkButton}" Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding ShowForgotCommand}" Content="Quên mật khẩu?"
                        Visibility="{Binding IsLoginMode, Converter={StaticResource BoolVis}}"/>

                <Button Style="{StaticResource LinkButton}" Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding ShowLoginCommand}" Content="Quay lại đăng nhập"
                        Visibility="{Binding IsForgotMode, Converter={StaticResource BoolVis}}"/>
              </StackPanel>
            </ScrollViewer>

            <!-- Lối vào nhanh -->
            <StackPanel Grid.Row="2">
                <Rectangle Height="1" Fill="{DynamicResource CardBorderBrush}" Margin="0,0,0,16"/>
                <Button Style="{StaticResource GhostButton}"
                        Command="{Binding PlayAsGuestCommand}"
                        ToolTip="Vào ngay, không cần tài khoản - chỉ chơi được chế độ Cổ điển"
                        Content="Khách"/>
            </StackPanel>
        </Grid>

        <!-- ==================== Lớp phủ: hướng dẫn ====================
             Gom mọi lời giải thích vào một chỗ. Màn hình chính chỉ còn nút "?",
             ai cần thì mở ra đọc. -->
        <Grid Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}"
              Visibility="{Binding IsHelpOpen, Converter={StaticResource BoolVis}}">
            <Border Style="{StaticResource Card}" CornerRadius="20" Padding="36,30"
                    Width="560" MaxHeight="620"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Hướng dẫn"
                               FontSize="26" FontWeight="Bold" Margin="0,0,0,16"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center" Margin="0,20,0,0"
                            Command="{Binding HideHelpCommand}" Content="Đã hiểu"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- ===== Tổng quan cách chơi: ba bước, mỗi bước một dòng ===== -->
                            <TextBlock Text="CHƠI THẾ NÀO" Style="{StaticResource SectionLabel}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Style="{StaticResource StepNumber}">
                                    <TextBlock Text="1" Style="{StaticResource StepNumberText}"/>
                                </Border>
                                <TextBlock Style="{StaticResource StepText}"
                                           Text="Nhìn bức hình gợi ý ở giữa màn chơi."/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Style="{StaticResource StepNumber}">
                                    <TextBlock Text="2" Style="{StaticResource StepNumberText}"/>
                                </Border>
                                <TextBlock Style="{StaticResource StepText}"
                                           Text="Bấm các phím chữ cái phía dưới để ghép thành đáp án; bấm lại ô đáp án để lấy chữ ra."/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,18">
                                <Border Style="{StaticResource StepNumber}">
                                    <TextBlock Text="3" Style="{StaticResource StepNumberText}"/>
                                </Border>
                                <TextBlock Style="{StaticResource StepText}"
                                           Text="Điền kín ô là game tự chấm, đúng thì sang câu mới."/>
                            </StackPanel>

                            <!-- ===== Vì sao nên đăng nhập ===== -->
                            <TextBlock Text="ĐĂNG NHẬP" Style="{StaticResource SectionLabel}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22"
                                       Margin="0,6,0,18"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Đăng nhập để giữ điểm, kim cương và tiến trình của riêng bạn, và để đấu với người khác. Chưa có tài khoản thì bấm Đăng ký. Bấm Khách thì vào chơi được ngay, nhưng chỉ chơi được chế độ Cổ điển và mọi người dùng chung một hồ sơ khách."/>

                            <!-- ===== Ủng hộ nhà phát triển =====
                                 Ảnh QR để trong Assets/TaiNguyen, đặt tên
                                 "qr-ung-ho", đuôi gì cũng được. Chưa có ảnh thì
                                 hiện ô gạch đứt chỉ chỗ đặt, chứ không để game
                                 nổ lỗi - xem LoadQrImage() và AppImageLocator. -->
                            <TextBlock Text="ỦNG HỘ NHÀ PHÁT TRIỂN"
                                       Style="{StaticResource SectionLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Grid Width="104" Height="104">
                                    <Border x:Name="QrPlaceholder" CornerRadius="8"
                                            BorderThickness="2"
                                            Background="{DynamicResource CardAltBrush}"
                                            BorderBrush="{DynamicResource SlotEmptyBrush}">
                                        <TextBlock Text="Đặt ảnh QR vào&#10;Assets/TaiNguyen/&#10;tên qr-ung-ho"
                                                   TextAlignment="Center" FontSize="11"
                                                   LineHeight="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Border>
                                    <Image x:Name="QrImage" Visibility="Collapsed"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>

                                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22"
                                           Margin="16,0,0,0" MaxWidth="330"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Game miễn phí, làm cho vui. Quét mã bên cạnh nếu bạn muốn ủng hộ mình một ly cà phê."/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
