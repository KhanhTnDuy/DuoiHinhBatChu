<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:DuoiHinhBatChu.Converters">

    <!--
        Kiểu dùng chung cho mọi cửa sổ (màn đăng nhập và màn chơi).
        Màu sắc đều lấy bằng DynamicResource nên đổi sáng/tối là tự đổi theo.
    -->

    <!-- Thẻ nội dung: nền nổi trên canvas, bo góc 16, viền mảnh -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Nhãn nhỏ in hoa phía trên mỗi khối -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <!-- Từng là 11: nhìn trên màn 1920x1080 quá nhỏ, người chơi thử (2026-09-15) phải nheo mắt -->
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
    </Style>

    <!-- ===== Danh sách các bước đánh số (dùng ở màn đăng nhập) =====
         Một hàng = ô tròn đánh số + một dòng chữ. Tách ra thành style để ba
         bước giống hệt nhau, sửa một chỗ là đổi cả ba. -->
    <Style x:Key="StepNumber" TargetType="Border">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
    </Style>

    <Style x:Key="StepNumberText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    </Style>

    <Style x:Key="StepText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="21"/>
        <Setter Property="MaxWidth" Value="340"/>
        <Setter Property="Margin" Value="12,2,0,0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- Số liệu HUD: chữ đơn cách để con số không nhảy khi tăng -->
    <Style x:Key="HudValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Nút chính: nền đậm, góc chữ nhật bo nhẹ cho khớp ô nhập -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="10" Padding="22,11"
                            Background="{DynamicResource PrimaryBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource PrimaryHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút phụ: chỉ có viền -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="10" Padding="16,9"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource PrimarySoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Mảnh ghép của thẻ chọn chế độ chơi =====
         Ô biểu tượng, viên trạng thái và chip thông tin - xếp lại thì một thẻ
         chế độ có đủ thứ để nhìn, không còn là một hộp trống mấy dòng chữ. -->

    <!-- Ô vuông bo góc đựng biểu tượng, 44x44 -->
    <Style x:Key="ModeIcon" TargetType="Border">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
    </Style>

    <!-- Viên bo tròn hết cỡ: nhãn trạng thái OFFLINE / ONLINE -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Chip thông tin: một mẩu sự thật về chế độ, vd "5 mạng" -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Background" Value="{DynamicResource CardAltBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- Nét vẽ của các biểu tượng người: dùng chung cho cả hai thẻ -->
    <Style x:Key="ModeIconStroke" TargetType="Path">
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
    </Style>

    <!-- Nút hành động màu hổ phách, cho thẻ đấu nhiều người -->
    <Style x:Key="TertiaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#291800"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="10" Padding="22,11"
                            Background="{DynamicResource TertiaryBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thanh thời gian còn lại của câu đang chơi.
         Giá trị chạy từ 1 về 0, nên thanh ngắn dần chứ không dài ra. -->
    <Style x:Key="TimeBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource CardAltBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="999" ClipToBounds="True"
                            Background="{TemplateBinding Background}">
                        <Grid>
                            <Rectangle x:Name="PART_Track"/>
                            <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                       RadiusX="4" RadiusY="4"
                                       Fill="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút phụ nền nhạt.
         GhostButton lấy nền CardBrush nên đặt NGAY TRONG một thẻ Card là hai
         nền trùng màu, nút gần như tàng hình. Nút này lấy nền PrimarySoftBrush
         nên vẫn nổi trên mặt thẻ, mà không tranh chỗ với nút chính. -->
    <Style x:Key="SoftButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="10" Padding="16,10"
                            Background="{DynamicResource PrimarySoftBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource OnPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút dạng thẻ, dùng cho hàng trợ giúp và ô chọn chế độ chơi -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="12" Padding="12,10"
                            Background="{DynamicResource CardAltBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush"
                                    Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ô nhập chữ -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg" CornerRadius="10"
                            Background="{DynamicResource CardAltBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            <!-- Chữ mờ (conv:Placeholder.Text): chỉ hiện khi ô trống
                                 và chưa bấm vào; bấm vào là biến mất -->
                            <TextBlock x:Name="Hint" Margin="{TemplateBinding Padding}"
                                       Text="{TemplateBinding conv:Placeholder.Text}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsKeyboardFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush"
                                    Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ô nhập mật khẩu, giữ đúng dáng với Field -->
    <Style x:Key="PasswordField" TargetType="PasswordBox">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bg" CornerRadius="10"
                            Background="{DynamicResource CardAltBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            <!-- Chữ mờ như Field. PasswordBox không lộ nội dung để
                                 trigger được, nên "ô trống" lấy từ conv:Placeholder.HasContent -->
                            <TextBlock x:Name="Hint" Margin="{TemplateBinding Padding}"
                                       Text="{TemplateBinding conv:Placeholder.Text}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="conv:Placeholder.HasContent" Value="False"/>
                                <Condition Property="IsKeyboardFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush"
                                    Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Biểu tượng nút đổi sáng/tối. Vẽ bằng đường nét (Path) chứ không dùng
        emoji, để nét và màu ăn theo bảng màu đang dùng.
        Cả hai hình vẽ trong khung 24x24.
    -->

    <!-- Mặt trời: vòng tròn giữa + 8 tia -->
    <StreamGeometry x:Key="SunIcon">
        M 12,7.5 A 4.5,4.5 0 1 1 11.99,7.5
        M 12,3.2 L 12,5.4
        M 12,18.6 L 12,20.8
        M 3.2,12 L 5.4,12
        M 18.6,12 L 20.8,12
        M 5.78,5.78 L 7.34,7.34
        M 16.66,16.66 L 18.22,18.22
        M 5.78,18.22 L 7.34,16.66
        M 16.66,7.34 L 18.22,5.78
    </StreamGeometry>

    <!-- Mặt trăng: hình lưỡi liềm -->
    <StreamGeometry x:Key="MoonIcon">
        M 20.5,15.1 A 8.6,8.6 0 1 1 8.9,3.5 A 6.9,6.9 0 0 0 20.5,15.1 Z
    </StreamGeometry>

    <!--
        Nút đổi sáng/tối. Đang nền sáng thì hiện mặt trời, đang nền tối thì
        hiện mặt trăng — biểu tượng cho biết đang ở chế độ nào.
        Cần DataContext có thuộc tính IsDarkTheme.
    -->
    <Style x:Key="ThemeToggleButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Không nhận tiêu điểm bàn phím. Nếu nhận, nút này là ô bấm được đầu
             tiên của cửa sổ nên tự có tiêu điểm; phím Enter dùng để đăng nhập ở
             cửa sổ trước rơi sang đây và đổi nhầm sáng/tối. -->
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="ToolTip" Value="Đổi giữa nền sáng và nền tối"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="10"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Path x:Name="Icon"
                              Data="{StaticResource SunIcon}"
                              Stroke="{DynamicResource TertiaryBrush}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                            <Setter TargetName="Icon" Property="Data"
                                    Value="{StaticResource MoonIcon}"/>
                            <Setter TargetName="Icon" Property="Stroke"
                                    Value="{DynamicResource SecondaryBrush}"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource PrimarySoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút quay lại: cùng cỡ và cùng kiểu với nút đổi nền để đặt cạnh nhau ở
         góc màn hình. Có ở mọi màn TRỪ màn đang chơi, vì đang giữa ván mà bấm
         nhầm là mất câu. Focusable=False cùng lý do với nút đổi nền. -->
    <StreamGeometry x:Key="BackIcon">M 15,5 L 8,12 L 15,19 M 8,12 L 20,12</StreamGeometry>

    <Style x:Key="BackButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="ToolTip" Value="Quay lại"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="10"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Path Data="{StaticResource BackIcon}"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource PrimarySoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thẻ chọn kiểu chơi trong phòng chờ. Đặt Tag="True" khi đang được chọn:
         viền và nền chuyển sang màu chính. Tắt (chỉ xem) thì mờ đi một chút chứ
         không xám hẳn, vì người không phải chủ phòng vẫn cần đọc được. -->
    <Style x:Key="ModeCard" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="14" Padding="16,14"
                            Background="{DynamicResource CardAltBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="2">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush"
                                    Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                     Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource PrimarySoftBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush"
                                    Value="{DynamicResource PrimaryBrush}"/>
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút dạng đường dẫn: không nền không viền, chỉ là chữ bấm được -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" Padding="6,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource PrimaryHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nút "?" mở bảng hướng dẫn. Cùng cỡ với nút đổi sáng/tối để đứng cạnh cho đều -->
    <Style x:Key="HelpButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Chỉ bấm bằng chuột, giống nút đổi sáng/tối: không nhận tiêu điểm bàn
             phím để Enter hay Space không bấm nhầm vào nó. -->
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="ToolTip" Value="Xem hướng dẫn chơi"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="10"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <TextBlock Text="?" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource PrimarySoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nhãn nhỏ đặt ngay trên ô nhập -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

</ResourceDictionary>
