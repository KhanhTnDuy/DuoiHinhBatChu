<Window x:Class="DuoiHinhBatChu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:DuoiHinhBatChu.Converters"
        Title="Đuổi hình bắt chữ"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource CanvasBrush}"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:StringToVisibilityConverter x:Key="StrVis"/>

        <!-- ============ Ô ký tự trong hàng đáp án ============ -->
        <DataTemplate x:Key="SlotTemplate">
            <Button Command="{Binding DataContext.TakeBackCommand,
                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Cursor="Hand"
                    Margin="5,6">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Width="56" Height="64">
                            <!-- Ô trống: viền nét đứt theo thiết kế -->
                            <Rectangle x:Name="Dash" RadiusX="12" RadiusY="12"
                                       Stroke="{DynamicResource SlotEmptyBrush}"
                                       StrokeThickness="2" StrokeDashArray="4 3"/>
                            <Border x:Name="Fill" CornerRadius="12" Background="Transparent"/>
                            <TextBlock x:Name="Char" Text="{Binding DisplayText}"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource SlotFilledTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Đã điền chữ: nền đặc, bỏ nét đứt -->
                            <DataTrigger Binding="{Binding HasValue}" Value="True">
                                <Setter TargetName="Dash" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SlotFilledBrush}"/>
                            </DataTrigger>
                            <!-- Chữ do trợ giúp mở: tô màu hổ phách -->
                            <DataTrigger Binding="{Binding IsRevealedByHint}" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource TertiaryBrush}"/>
                                <Setter TargetName="Char" Property="Foreground" Value="#1B1200"/>
                            </DataTrigger>
                            <!-- Vừa trả lời sai -->
                            <DataTrigger Binding="{Binding IsWrong}" Value="True">
                                <Setter TargetName="Dash" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource ErrorBrush}"/>
                                <Setter TargetName="Char" Property="Foreground" Value="#FFFFFF"/>
                            </DataTrigger>
                            <!-- Khoảng trắng giữa hai từ: chỉ là chỗ hở, không bấm được -->
                            <DataTrigger Binding="{Binding IsSpace}" Value="True">
                                <Setter TargetName="Root" Property="Width" Value="22"/>
                                <Setter TargetName="Dash" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Fill" Property="Background" Value="Transparent"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- ============ Phím chữ cái (dáng keycap có gờ dưới) ============ -->
        <DataTemplate x:Key="TileTemplate">
            <Button Command="{Binding DataContext.PlaceLetterCommand,
                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Cursor="Hand"
                    Margin="5">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Key" Width="52" Height="52" CornerRadius="12"
                                Background="{DynamicResource TileBrush}"
                                BorderBrush="{DynamicResource TileBevelBrush}"
                                BorderThickness="0,0,0,3">
                            <TextBlock Text="{Binding Character}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource TileTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Key" Property="Background"
                                        Value="{DynamicResource TileHoverBrush}"/>
                            </Trigger>
                            <!-- Đã dùng / bị xóa: ẩn nhưng giữ chỗ để bàn phím không nhảy -->
                            <DataTrigger Binding="{Binding IsUsed}" Value="True">
                                <Setter TargetName="Key" Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEliminated}" Value="True">
                                <Setter TargetName="Key" Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== Cột trái: thương hiệu + thống kê ==================== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="ĐUỔI HÌNH" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="BẮT CHỮ" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,24,0,0">
                    <!-- Người chơi hiện tại -->
                    <TextBlock Text="NGƯỜI CHƠI" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="{Binding PlayerName}" FontSize="16" FontWeight="SemiBold"
                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding AccountKindText}" FontSize="12" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"/>

                    <TextBlock Text="ĐIỀU HƯỚNG" Style="{StaticResource SectionLabel}"
                               Margin="0,24,0,0"/>
                    <Border CornerRadius="12" Padding="14,11" Margin="0,10,0,0"
                            Background="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="Chế độ cổ điển" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnPrimaryBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Thống kê đáy cột, giống khối STREAK / COINS trong thiết kế -->
                <Border Grid.Row="3" Style="{StaticResource Card}"
                        Background="{DynamicResource CardAltBrush}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="ĐÃ GIẢI" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SolvedText}" Style="{StaticResource HudValue}"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="KIM CƯƠNG" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Rubies}" Style="{StaticResource HudValue}"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TertiaryBrush}"/>
                        </Grid>
                        <!-- Đúng liên tiếp: đủ 5 là được thêm 1 kim cương -->
                        <Grid>
                            <TextBlock Text="ĐÚNG LIÊN TIẾP" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StreakText}" Style="{StaticResource HudValue}"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== Cột phải: màn chơi ==================== -->
        <Grid Grid.Column="1" Margin="24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- === Thanh HUD === -->
            <StackPanel Grid.Row="0">
            <Grid>
                <Border Style="{StaticResource Card}" HorizontalAlignment="Left" Padding="18,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ProgressText}" FontSize="18" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Rectangle Width="1" Margin="16,2" Fill="{DynamicResource CardBorderBrush}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ĐỘ KHÓ" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding DifficultyText}"
                                       Style="{StaticResource HudValue}" FontSize="15"
                                       Foreground="{DynamicResource TertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Thời gian còn lại của câu này; sát giờ thì đổi sang màu báo động -->
                    <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="THỜI GIAN" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding TimeText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource HudValue}">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTimeLow}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MẠNG" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding LivesText}" Style="{StaticResource HudValue}"
                                       Foreground="{DynamicResource ErrorBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ĐIỂM" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Score}" Style="{StaticResource HudValue}"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,10,0"
                            Background="{DynamicResource TertiarySoftBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="KIM CƯƠNG" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Rubies}" Style="{StaticResource HudValue}"
                                       Foreground="{DynamicResource TertiaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Nút đổi chế độ sáng / tối: mặt trời khi đang sáng, mặt trăng khi đang tối -->
                    <Button Style="{StaticResource ThemeToggleButton}" Margin="0,0,8,0"
                            Command="{Binding ToggleThemeCommand}"/>
                    <Button Style="{StaticResource GhostButton}" Content="Tạm dừng"
                            Command="{Binding PauseCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Thanh thời gian chạy hết chiều ngang: nhìn cái biết còn bao lâu,
                 không phải đọc con số -->
            <ProgressBar Value="{Binding TimeFraction, Mode=OneWay}" Margin="0,12,0,0">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource TimeBar}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTimeLow}" Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ErrorBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            </StackPanel>

            <!-- === Ba cột: thông tin | ảnh | trợ giúp ===
                 Tạm dừng thì giấu hết: ảnh, ô đáp án và bàn phím chữ. -->
            <Grid Grid.Row="1" Margin="0,18"
                  Visibility="{Binding IsPaused, Converter={StaticResource BoolVis},
                               ConverterParameter=Invert}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Thẻ trái: mô tả hình + số liệu câu đố -->
                <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="THÔNG TIN CÂU ĐỐ" Style="{StaticResource SectionLabel}"/>
                        <Border CornerRadius="12" Padding="12" Margin="0,12,0,0"
                                Background="{DynamicResource CardAltBrush}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Số chữ cái" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding LetterCountText}" FontSize="13"
                                               FontWeight="Bold" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Đã giải" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SolvedText}" FontSize="13"
                                               FontWeight="Bold" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Gợi ý bằng lời, chỉ hiện sau khi mua -->
                        <Border CornerRadius="12" Padding="12" Margin="0,10,0,0"
                                Background="{DynamicResource TertiarySoftBrush}"
                                Visibility="{Binding HintText, Converter={StaticResource StrVis}}">
                            <TextBlock Text="{Binding HintText}" TextWrapping="Wrap" FontSize="13"
                                       LineHeight="20"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Câu hỏi + khung ảnh câu đố -->
                <Grid Grid.Column="1" Margin="18,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Nói thẳng người chơi phải làm gì, thay vì để họ tự đoán -->
                    <TextBlock Grid.Row="0" Text="Đây là gì?" FontSize="26" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                <Border Grid.Row="1" CornerRadius="24" Padding="10"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Image Source="{Binding ImageSource}" Stretch="Uniform"
                               Visibility="{Binding HasImage, Converter={StaticResource BoolVis}}"/>

                        <!-- Chỉ gặp khi file ảnh bị xóa hoặc hỏng giữa chừng -->
                        <TextBlock Text="Không đọc được ảnh của câu đố này."
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontSize="18"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   Visibility="{Binding HasImage, Converter={StaticResource BoolVis},
                                                ConverterParameter=Invert}"/>
                    </Grid>
                </Border>
                </Grid>

                <!-- Thẻ phải: các trợ giúp -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="TRỢ GIÚP" Style="{StaticResource SectionLabel}"
                                   Margin="0,0,0,12"/>

                        <Button Style="{StaticResource CardButton}" Command="{Binding RevealLetterCommand}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Mở 1 chữ" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Điền sẵn một ô bất kỳ" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Text="1" Style="{StaticResource HudValue}" FontSize="15"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TertiaryBrush}"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource CardButton}" Command="{Binding BoomCommand}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Xóa chữ thừa" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Bỏ bớt phím gây nhiễu" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Text="1" Style="{StaticResource HudValue}" FontSize="15"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TertiaryBrush}"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource CardButton}" Command="{Binding ShowHintCommand}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Gợi ý" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Xem mô tả đáp án" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Text="1" Style="{StaticResource HudValue}" FontSize="15"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TertiaryBrush}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- === Hàng ô đáp án === -->
            <StackPanel Grid.Row="2"
                        Visibility="{Binding IsPaused, Converter={StaticResource BoolVis},
                                     ConverterParameter=Invert}">
                <TextBlock Text="ĐÁP ÁN" Style="{StaticResource SectionLabel}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding FeedbackText}" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,6,0,0"
                           Visibility="{Binding FeedbackText, Converter={StaticResource StrVis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFeedbackGood}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Slots}"
                              ItemTemplate="{StaticResource SlotTemplate}"
                              HorizontalAlignment="Center" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- === Bàn phím chữ cái === -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,16"
                    Visibility="{Binding IsPaused, Converter={StaticResource BoolVis},
                                 ConverterParameter=Invert}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                               FontSize="12" LineHeight="18"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="Bấm chữ để điền · bấm lại ô đáp án để lấy chữ ra · ESC để tạm dừng"/>

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Tiles}"
                                  ItemTemplate="{StaticResource TileTemplate}"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                           MaxWidth="620"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding SkipCommand}" Content="Bỏ qua"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== Lớp phủ: tạm dừng ====================
             Nền phủ kín cả cửa sổ nên vừa che nốt phần còn thấy được, vừa nuốt
             mọi cú bấm - người chơi không lỡ tay chạm vào bàn phím chữ. -->
        <Grid Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}"
              Visibility="{Binding IsPaused, Converter={StaticResource BoolVis}}">
            <Border Style="{StaticResource Card}" CornerRadius="24" Padding="44,36"
                    Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Hai vạch đứng: dấu tạm dừng quen mắt -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="10" Height="34" CornerRadius="3" Margin="0,0,7,0"
                                Background="{DynamicResource PrimaryBrush}"/>
                        <Border Width="10" Height="34" CornerRadius="3"
                                Background="{DynamicResource PrimaryBrush}"/>
                    </StackPanel>

                    <TextBlock Text="Tạm dừng" FontSize="30" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,16,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22"
                               TextAlignment="Center" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Đồng hồ đã dừng. Ảnh và ô đáp án được giấu đi, nghỉ xong bấm Tiếp tục là hiện lại."/>

                    <Button Style="{StaticResource PrimaryButton}" Margin="0,24,0,0"
                            Command="{Binding ResumeCommand}" Content="Tiếp tục"/>

                    <Button Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                            Click="Close_Click" Content="Về màn hình chính"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== Lớp phủ: hết mạng ==================== -->
        <Grid Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}"
              Visibility="{Binding IsGameOver, Converter={StaticResource BoolVis}}">
            <Border Style="{StaticResource Card}" CornerRadius="24" Padding="48,40"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Hết mạng rồi!" FontSize="34" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Score, StringFormat=Điểm của bạn: {0}}"
                               FontSize="18" Margin="0,12,0,24" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding RestartCommand}"
                            Content="Chơi lại" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== Lớp phủ: hết bộ câu đố ==================== -->
        <Grid Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}"
              Visibility="{Binding IsFinished, Converter={StaticResource BoolVis}}">
            <Border Style="{StaticResource Card}" CornerRadius="24" Padding="48,40"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Bạn đã chơi hết bộ câu đố!" FontSize="30" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Score, StringFormat=Tổng điểm: {0}}"
                               FontSize="18" Margin="0,12,0,24" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding RestartCommand}"
                            Content="Chơi lại từ đầu" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
