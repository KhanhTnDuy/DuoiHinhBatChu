<Window x:Class="DuoiHinhBatChu.ModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:DuoiHinhBatChu.Converters"
        Title="Đuổi hình bắt chữ - Chọn chế độ chơi"
        Width="880" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource CanvasBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:StringToVisibilityConverter x:Key="StrVis"/>
    </Window.Resources>

    <Grid Margin="40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- === Đầu trang: người đang đăng nhập === -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="NGƯỜI CHƠI" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="{Binding PlayerName}" FontSize="26" FontWeight="Bold"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding AccountKindText}" FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>

            <Button Style="{StaticResource ThemeToggleButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding ToggleThemeCommand}"/>
        </Grid>

        <!-- === Hai thẻ chế độ === -->
        <Grid Grid.Row="1" Margin="0,28,0,0"
              Visibility="{Binding IsOnlinePanelOpen, Converter={StaticResource BoolVis},
                           ConverterParameter=Invert}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Một mình -->
            <Button Grid.Column="0" Style="{StaticResource CardButton}" Margin="0,0,10,0"
                    Command="{Binding PlaySoloCommand}">
                <StackPanel Margin="10">
                    <TextBlock Text="Chơi một mình" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="OFFLINE" Style="{StaticResource SectionLabel}"
                               Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" Margin="0,16,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Chạy hẳn trên máy này, không cần mạng. Có mạng sống, kim cương và các trợ giúp. Điểm lưu vào hồ sơ của bạn."/>
                </StackPanel>
            </Button>

            <!-- Nhiều người -->
            <Button Grid.Column="1" Style="{StaticResource CardButton}" Margin="10,0,0,0"
                    Command="{Binding ShowOnlineCommand}">
                <StackPanel Margin="10">
                    <TextBlock Text="Đấu nhiều người" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="ONLINE - CẦN MÁY CHỦ" Style="{StaticResource SectionLabel}"
                               Foreground="{DynamicResource TertiaryBrush}" Margin="0,6,0,0"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" Margin="0,16,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Từ 2 người trở lên, cùng một câu đố. Ai trả lời nhanh hơn được nhiều điểm hơn: trả lời ngay được gần trọn điểm, sát giờ còn 20%."/>

                    <Border CornerRadius="10" Padding="12,9" Margin="0,16,0,0"
                            Background="{DynamicResource ErrorSoftBrush}"
                            Visibility="{Binding OnlineBlockedText,
                                         Converter={StaticResource StrVis}}">
                        <TextBlock Text="{Binding OnlineBlockedText}" TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{DynamicResource ErrorBrush}"/>
                    </Border>
                </StackPanel>
            </Button>
        </Grid>

        <!-- === Bảng nối máy chủ === -->
        <Border Grid.Row="1" Margin="0,28,0,0" Style="{StaticResource Card}"
                VerticalAlignment="Top"
                Visibility="{Binding IsOnlinePanelOpen, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="8">
                <TextBlock Text="NỐI TỚI MÁY CHỦ" Style="{StaticResource SectionLabel}"/>
                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,8,0,16"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Máy chủ là dự án DuoiHinhBatChu.Server. Chạy nó trên một máy trong nhà bằng lệnh: dotnet run --launch-profile lan"/>

                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="Địa chỉ máy chủ (ví dụ 192.168.1.10:5180)"/>
                <TextBox Style="{StaticResource Field}"
                         Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding CheckServerCommand}" Content="Thử kết nối"/>
                    <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                            Command="{Binding HideOnlineCommand}" Content="Quay lại"/>
                </StackPanel>

                <Border CornerRadius="10" Padding="12,9" Margin="0,16,0,0"
                        Visibility="{Binding ServerMessage, Converter={StaticResource StrVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsServerOk}" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource PrimarySoftBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ServerMessage}" TextWrapping="Wrap" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerOk}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource PrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Border CornerRadius="10" Padding="12,9" Margin="0,10,0,0"
                        Background="{DynamicResource TertiarySoftBrush}"
                        Visibility="{Binding IsServerOk, Converter={StaticResource BoolVis}}">
                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="Máy chủ đã sẵn sàng. Phần tạo phòng và vào đấu đang làm dở, nên bản này mới thử được kết nối thôi."/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
