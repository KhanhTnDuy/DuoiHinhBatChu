<Window x:Class="DuoiHinhBatChu.ModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:DuoiHinhBatChu.Converters"
        Title="Đuổi hình bắt chữ - Chọn chế độ chơi"
        Width="880" Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource SkyBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:StringToVisibilityConverter x:Key="StrVis"/>
    </Window.Resources>

    <Grid Margin="40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- người chơi -->
            <RowDefinition Height="Auto"/>   <!-- tên màn hình -->
            <RowDefinition Height="*"/>      <!-- hai thẻ chế độ / bảng nối máy chủ -->
            <RowDefinition Height="Auto"/>   <!-- mẹo cuối trang -->
        </Grid.RowDefinitions>

        <!-- === Đầu trang: người đang đăng nhập === -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <!-- Ô chữ cái đầu của tên, thay cho ảnh đại diện -->
                <Border Width="46" Height="46" CornerRadius="13"
                        Background="{DynamicResource PrimaryBrush}">
                    <TextBlock Text="{Binding Initials}" FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource OnPrimaryBrush}"/>
                </Border>

                <!-- Lời chào thay cho "NGƯỜI CHƠI" + tên + nhãn loại tài khoản:
                     tên đã nằm trong câu chào, còn chuyện khách hay không thì
                     hai thẻ chế độ bên dưới đã nói rõ hơn nhiều -->
                <TextBlock Text="{Binding Greeting}" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="14,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource BackButton}" Margin="0,0,8,0"
                        ToolTip="Đăng xuất, về màn đăng nhập"
                        Command="{Binding BackCommand}"/>
                <Button Style="{StaticResource ThemeToggleButton}"
                        Command="{Binding ToggleThemeCommand}"/>
            </StackPanel>
        </Grid>

        <!-- === Tên màn hình, đặt giữa cho cân với hai thẻ bên dưới === -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,26,0,0">
            <Border Style="{StaticResource Pill}" HorizontalAlignment="Center"
                    Background="{DynamicResource PrimarySoftBrush}">
                <TextBlock Text="ĐUỔI HÌNH BẮT CHỮ" Style="{StaticResource PillText}"
                           Foreground="{DynamicResource PrimaryBrush}"/>
            </Border>
            <TextBlock Text="Chọn chế độ chơi" FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Chơi Cổ điển cho thong thả, hay đua với bạn bè cho vui?"
                       FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>

        <!-- === Hai thẻ chế độ ===
             Mỗi thẻ xếp theo đúng thứ tự của bản thiết kế: biểu tượng + nhãn
             trạng thái, tên chế độ, mô tả, hàng chip, rồi nút "Chơi ngay" ghim
             dưới đáy. Nút ghim đáy nên hai thẻ cao bằng nhau và không còn
             khoảng trống lửng lơ như bản cũ. -->
        <Grid Grid.Row="2" Margin="0,26,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Cổ điển ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Biểu tượng một người + nhãn trạng thái -->
                    <Grid Grid.Row="0">
                        <Border Style="{StaticResource ModeIcon}" HorizontalAlignment="Left">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource ModeIconStroke}"
                                          Stroke="{DynamicResource PrimaryBrush}"
                                          Data="M 12,4.5 A 3.5,3.5 0 1 1 11.99,4.5 Z"/>
                                    <Path Style="{StaticResource ModeIconStroke}"
                                          Stroke="{DynamicResource PrimaryBrush}"
                                          Data="M 5,20 A 7,7 0 0 1 19,20"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Right"
                                Background="{DynamicResource PrimarySoftBrush}">
                            <TextBlock Text="OFFLINE" Style="{StaticResource PillText}"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Tên chế độ + nhãn phụ -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="Cổ điển" FontSize="22" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                                Background="{DynamicResource PrimarySoftBrush}"
                                BorderThickness="0" VerticalAlignment="Center">
                            <TextBlock Text="Cá nhân" Style="{StaticResource ChipText}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Câu dẫn thay cho đoạn mô tả khô: mấy chuyện 5 mạng,
                         trợ giúp, lưu tiến trình đã nằm ở hàng chip bên dưới -->
                    <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="15" LineHeight="24"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Luyện tay cho chắc, rồi hãy đi giành ngôi vô địch."/>

                    <!-- Hàng chip: mấy điều cần biết trước khi chọn -->
                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <Rectangle Height="1" Fill="{DynamicResource CardBorderBrush}"
                                   Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="❤ 5 mạng" Style="{StaticResource ChipText}"/>
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="◆ 2 trợ giúp" Style="{StaticResource ChipText}"/>
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="↺ Lưu tiến trình"
                                           Style="{StaticResource ChipText}"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <Button Grid.Row="5" Style="{StaticResource PrimaryButton}"
                            Command="{Binding PlaySoloCommand}" Content="Đi tới menu  →"/>
                </Grid>
            </Border>

            <!-- ===== Nhiều người ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Biểu tượng hai người + nhãn trạng thái -->
                    <Grid Grid.Row="0">
                        <Border Style="{StaticResource ModeIcon}" HorizontalAlignment="Left"
                                Background="{DynamicResource TertiarySoftBrush}">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource ModeIconStroke}"
                                          Stroke="{DynamicResource TertiaryBrush}"
                                          Data="M 9,5.5 A 3,3 0 1 1 8.99,5.5 Z"/>
                                    <Path Style="{StaticResource ModeIconStroke}"
                                          Stroke="{DynamicResource TertiaryBrush}"
                                          Data="M 3.5,20 A 5.5,5.5 0 0 1 14.5,20"/>
                                    <Path Style="{StaticResource ModeIconStroke}"
                                          Stroke="{DynamicResource TertiaryBrush}"
                                          Data="M 17.5,4.5 A 2.5,2.5 0 1 1 17.49,4.5 Z"/>
                                    <Path Style="{StaticResource ModeIconStroke}"
                                          Stroke="{DynamicResource TertiaryBrush}"
                                          Data="M 16,11.5 A 4.5,4.5 0 0 1 21.5,16"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Right"
                                Background="{DynamicResource SuccessSoftBrush}">
                            <TextBlock Text="ONLINE"
                                       Style="{StaticResource PillText}"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="Nhiều người chơi" FontSize="22" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                                Background="{DynamicResource TertiarySoftBrush}"
                                BorderThickness="0" VerticalAlignment="Center">
                            <TextBlock Text="Đua tốc độ" Style="{StaticResource ChipText}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TertiaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="15" LineHeight="24"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Cùng một câu đố, ai nhanh tay hơn thì thắng."/>

                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <Rectangle Height="1" Fill="{DynamicResource CardBorderBrush}"
                                   Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="⏱ 20 giây / câu"
                                           Style="{StaticResource ChipText}"/>
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="⚡ Thi đấu trực tiếp"
                                           Style="{StaticResource ChipText}"/>
                            </Border>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="★ Nhanh hơn được nhiều điểm hơn"
                                           Style="{StaticResource ChipText}"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Khách thì chưa đấu được, nói rõ ngay trên thẻ -->
                    <Border Grid.Row="4" CornerRadius="10" Padding="12,9" Margin="0,4,0,12"
                            VerticalAlignment="Top"
                            Background="{DynamicResource ErrorSoftBrush}"
                            Visibility="{Binding OnlineBlockedText,
                                         Converter={StaticResource StrVis}}">
                        <TextBlock Text="{Binding OnlineBlockedText}" TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{DynamicResource ErrorBrush}"/>
                    </Border>

                    <!-- Hai lối vào: có phòng bạn bè mở sẵn thì vào, chưa thì tự mở -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SoftButton}" Margin="0,0,5,0"
                                HorizontalContentAlignment="Center"
                                Command="{Binding JoinRoomCommand}" Content="Vào phòng"/>
                        <Button Grid.Column="1" Style="{StaticResource TertiaryButton}" Margin="5,0,0,0"
                                HorizontalContentAlignment="Center"
                                Command="{Binding CreateRoomCommand}" Content="Tạo phòng ngay  →"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- === Mẹo cuối trang === -->
        <TextBlock Grid.Row="3" Margin="0,20,0,0" FontSize="13"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Text="Mẹo: chơi Cổ điển để luyện, rồi rủ bạn vào đấu cho biết ai nhanh hơn."/>

    </Grid>
</Window>
